<odoo>

	<record id="res_groups_privilege_project_dashboard" model="res.groups.privilege">
		<field name="name">Project Dashboard</field>
		<field name="sequence">40</field>
		<field name="category_id" ref="base.module_category_services"/>
	</record>

	<record id="group_dashboard_pm" model="res.groups">
		<field name="name">Project Manager (own projects)</field>
		<field name="comment">Sees the dashboard restricted to the projects they are responsible for.</field>
		<field name="sequence">10</field>
		<field name="privilege_id" ref="res_groups_privilege_project_dashboard"/>
		<field name="implied_ids" eval="[Command.link(ref('project.group_project_user'))]"/>
	</record>

	<record id="group_dashboard_area_lead" model="res.groups">
		<field name="name">Area Lead</field>
		<field name="comment">Sees every project, without the economic margin.</field>
		<field name="sequence">20</field>
		<field name="privilege_id" ref="res_groups_privilege_project_dashboard"/>
		<field name="implied_ids" eval="[Command.link(ref('group_dashboard_pm'))]"/>
	</record>

	<record id="group_dashboard_manager" model="res.groups">
		<field name="name">Management</field>
		<field name="comment">Sees the whole portfolio including the estimated margin.</field>
		<field name="sequence">30</field>
		<field name="privilege_id" ref="res_groups_privilege_project_dashboard"/>
		<field name="implied_ids" eval="[Command.link(ref('group_dashboard_area_lead'))]"/>
	</record>

	<!-- El PM solo ve el histórico de los proyectos que tiene a cargo. -->
	<record id="rule_progress_snapshot_pm" model="ir.rule">
		<field name="name">Progress snapshot: own projects</field>
		<field name="model_id" ref="model_project_progress_snapshot"/>
		<field name="domain_force">[('project_id.user_id', '=', user.id)]</field>
		<field name="groups" eval="[Command.link(ref('group_dashboard_pm'))]"/>
	</record>

	<record id="rule_progress_snapshot_all" model="ir.rule">
		<field name="name">Progress snapshot: all projects</field>
		<field name="model_id" ref="model_project_progress_snapshot"/>
		<field name="domain_force">[(1, '=', 1)]</field>
		<field name="groups" eval="[Command.link(ref('group_dashboard_area_lead'))]"/>
	</record>

	<!-- Regla global (sin grupos): aísla por compañía. -->
	<record id="rule_progress_snapshot_company" model="ir.rule">
		<field name="name">Progress snapshot: multi-company</field>
		<field name="model_id" ref="model_project_progress_snapshot"/>
		<field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
	</record>

</odoo>
