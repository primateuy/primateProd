<odoo>

	<record id="view_task_form2_dashboard" model="ir.ui.view">
		<field name="name">project.task.form.inherit.primate.dashboard</field>
		<field name="model">project.task</field>
		<field name="inherit_id" ref="project.view_task_form2"/>
		<field name="arch" type="xml">
			<!-- tag_ids aparece también dentro de las listas de subtareas: se ancla al del grupo. -->
			<xpath expr="//group/field[@name='tag_ids']" position="after">
				<field name="blocking_state"/>
				<field name="blocked_since" invisible="not blocked_since"/>
			</xpath>
		</field>
	</record>

	<record id="view_task_tree2_dashboard" model="ir.ui.view">
		<field name="name">project.task.list.inherit.primate.dashboard</field>
		<field name="model">project.task</field>
		<!-- Vista base de lista: así los campos aparecen en todas sus variantes. -->
		<field name="inherit_id" ref="project.project_task_view_tree_base"/>
		<field name="arch" type="xml">
			<xpath expr="//list" position="inside">
				<field name="blocking_state" optional="hide"/>
			</xpath>
		</field>
	</record>

	<record id="view_task_search_form_dashboard" model="ir.ui.view">
		<field name="name">project.task.search.inherit.primate.dashboard</field>
		<field name="model">project.task</field>
		<field name="inherit_id" ref="project.view_task_search_form"/>
		<field name="arch" type="xml">
			<xpath expr="//search" position="inside">
				<separator/>
				<filter string="Blocked" name="primate_blocked" domain="[('blocking_state', '=', 'blocked')]"/>
				<filter string="Waiting for Customer" name="primate_waiting_customer"
					domain="[('blocking_state', '=', 'waiting_customer')]"/>
			</xpath>
		</field>
	</record>

</odoo>
