<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

	<t t-name="primate_project_dashboard.ProjectDashboard">
		<Layout className="'o_primate_dashboard'">
			<div class="o_primate_dashboard_content p-3">
				<div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
					<h1 class="o_primate_dashboard_title mb-0">Executive Dashboard</h1>
					<div class="d-flex flex-wrap gap-2 align-items-center">
						<!-- Sobre un dashboard roto no se ofrece cambiar de vista. -->
						<div t-if="!state.error" class="o_primate_view_switch btn-group btn-group-sm"
							role="group" aria-label="Dashboard view">
							<t t-foreach="views" t-as="view" t-key="view.value">
								<button type="button" class="btn"
									t-att-class="state.view === view.value ? 'btn-primary' : 'btn-outline-secondary'"
									t-att-aria-pressed="state.view === view.value ? 'true' : 'false'"
									t-att-data-view="view.value"
									t-on-click="() => this.onViewChange(view.value)"
									t-esc="view.label"/>
							</t>
						</div>
						<select class="form-select form-select-sm w-auto"
							t-att-title="periodTooltip"
							t-on-change="(ev) => this.onFilterChange('period', ev.target.value)">
							<t t-foreach="periods" t-as="period" t-key="period.value">
								<option t-att-value="period.value"
									t-att-selected="state.filters.period === period.value"
									t-esc="period.label"/>
							</t>
						</select>
						<t t-if="state.filters.period === 'custom'">
							<input type="date" class="form-control form-control-sm w-auto"
								t-att-value="state.filters.date_from || ''"
								t-on-change="(ev) => this.onFilterChange('date_from', ev.target.value)"/>
							<input type="date" class="form-control form-control-sm w-auto"
								t-att-value="state.filters.date_to || ''"
								t-on-change="(ev) => this.onFilterChange('date_to', ev.target.value)"/>
						</t>
						<select class="form-select form-select-sm w-auto"
							t-on-change="(ev) => this.onFilterChange('area', ev.target.value)">
							<option value="">All areas</option>
							<t t-foreach="selectorAreas" t-as="area" t-key="area.value">
								<option t-att-value="area.value"
									t-att-selected="state.filters.area === area.value"
									t-esc="area.name"/>
							</t>
						</select>
						<select class="form-select form-select-sm w-auto"
							t-on-change="(ev) => this.onIdFilterChange('user_id', ev.target.value)">
							<option value="">All managers</option>
							<t t-foreach="selectorUsers" t-as="user" t-key="user.id">
								<option t-att-value="user.id"
									t-att-selected="state.filters.user_id === user.id"
									t-esc="user.name"/>
							</t>
						</select>
						<select class="form-select form-select-sm w-auto"
							t-on-change="(ev) => this.onIdFilterChange('partner_id', ev.target.value)">
							<option value="">All customers</option>
							<t t-foreach="selectorPartners" t-as="partner" t-key="partner.id">
								<option t-att-value="partner.id"
									t-att-selected="state.filters.partner_id === partner.id"
									t-esc="partner.name"/>
							</t>
						</select>
						<button class="btn btn-sm"
							t-att-class="state.filters.only_at_risk ? 'btn-danger' : 'btn-outline-secondary'"
							t-on-click="onToggleAtRisk">
							At risk only
						</button>
						<button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.load()"
							title="Refresh">
							<i class="fa fa-refresh" role="img" aria-label="Refresh"/>
						</button>
					</div>
				</div>

				<t t-if="state.loading and !state.data">
					<div class="text-center text-muted py-5">
						<i class="fa fa-circle-o-notch fa-spin fa-2x" role="img" aria-label="Loading"/>
					</div>
				</t>
				<t t-elif="state.error">
					<div class="alert alert-danger" role="alert">
						The dashboard data could not be loaded.
					</div>
				</t>
				<t t-else="">
					<t t-component="viewComponent" t-props="viewProps"/>
				</t>
			</div>
		</Layout>
	</t>

</templates>
