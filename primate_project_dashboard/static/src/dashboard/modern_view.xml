<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

	<!-- El scope del tema (.o_ppd_modern) lo pone el raíz sobre el contenedor. -->
	<t t-name="primate_project_dashboard.DashboardModernView">
		<div class="o_ppd_modern_view">
			<ModernKpiCards kpis="props.data.kpis" config="props.data.config"/>
			<!-- Desde 1200px: progreso a la izquierda (7), donut y carga a la derecha (5).
			     Cada card conserva su altura natural; la columna corta termina antes. -->
			<div class="o_ppd_main_row">
				<div class="o_ppd_main_col">
					<ModernProjectList projects="props.rows" config="props.data.config"
						total="props.data.projects_total" hasMore="props.hasMoreRows"
						loadingMore="props.loadingMore"
						onOpenProject="props.onOpenProject" onLoadMore="props.onLoadMore"/>
				</div>
				<div class="o_ppd_side_col">
					<ModernTaskDonut areas="props.data.areas" onOpenTasks="props.onOpenAreaTasks"/>
					<ModernAreaWorkload areas="props.data.areas" onOpenTasks="props.onOpenAreaTasks"/>
				</div>
			</div>
			<ModernDeadlinesPanel alerts="props.data.alerts" total="props.data.alerts_total"
				today="props.data.config.today"
				onOpenRecord="props.onOpenAlertRecord" onSnooze="props.onSnooze"/>
		</div>
	</t>

</templates>
