<odoo>

	<record id="ir_cron_recompute_health_state" model="ir.cron">
		<field name="name">Project Dashboard: recompute health</field>
		<field name="model_id" ref="project.model_project_project"/>
		<field name="state">code</field>
		<field name="code">model._cron_recompute_health_state()</field>
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="nextcall" eval="(DateTime.now().replace(hour=5, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
		<field name="user_id" ref="base.user_root"/>
	</record>

	<record id="ir_cron_progress_snapshot" model="ir.cron">
		<field name="name">Project Dashboard: daily progress snapshot</field>
		<field name="model_id" ref="model_project_progress_snapshot"/>
		<field name="state">code</field>
		<field name="code">model._cron_take_snapshot()
env['project.dashboard.alert.snooze']._gc_expired_snoozes()</field>
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
		<field name="user_id" ref="base.user_root"/>
	</record>

</odoo>
