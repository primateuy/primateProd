<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<!--
	Vista: Agrega el campo de tarea asociada en el formulario de ticket
	para establecer el vínculo desde Helpdesk hacia Proyecto.
	-->
	<record id="view_helpdesk_ticket_form_inherit_task_link" model="ir.ui.view">
		<field name="name">helpdesk.ticket.form.inherit.task.link</field>
		<field name="model">helpdesk.ticket</field>
		<field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
		<field name="arch" type="xml">
			<!-- Campo para asociar tarea desde el ticket -->
			<xpath expr="//sheet//group[1]" position="inside">
				<label for="task_id"/>
				<field name="task_id" options="{'no_create_edit': True}" domain="[('project_id.enable_ticket_task_link', '=', True)]"/>
				<label for="project_id"/>
				<field name="project_id" readonly="1"/>
			</xpath>
		</field>
	</record>
</odoo>

